export EDITOR=nvim

# Practical usage
alias ls='ls --color=auto'
alias gs='git status --porcelain'
alias grep='grep --color -n'
alias la='ls -a'
alias makeshortcut="ln -s"
alias here="pwd | xsel -b"
alias copy="xsel -b"

alias vim='nvim'
alias cat='bat'

alias folderSize='du -hd 1'
alias gdb='gdb -tui'
alias make='make -s'
alias resource='source ~/.zshrc'

alias editi3='vim ~/dotfiles/.config/i3/config'
alias editAliases='vim ~/.aliases'
alias editAero='vim ~/dotfiles/.config/aerospace/.aerospace.toml'

  # Rebinds capslock to escape
#setxkbmap -option caps:escape

# Temporary aliases
  # EPTIA
EPITA_FOLDER=~/Documents/School/ING-EPITA/ING1
alias epita="cd $EPITA_FOLDER"

  # YAKA
alias yaka="/home/dup/Documents/Pro/YAKA/"
alias atmt="poetry run atmt"

alias ls="eza --icons=always"
alias autoTag="~/Scripts/autoTag.sh"
