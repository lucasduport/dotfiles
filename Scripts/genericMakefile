#$@: gets the name of the Makefile rule
#$^: gets all the prerequisites
#$<: gets the first prerequisite

CC = gcc
CPPFLAGS = -D_DEFAULT_SOURCE
SANITIZE = -g3 -fsanitize=address
CFLAGS = -Wall -Wextra -Werror -std=c99 -Wvla
VPATH = src
EXE = main
TARGET_LIB = 
OBJS =

all: exe

exe: main.o $(OBJS)
	$(CC) $(CFLAGS) -o $(EXE) $^
	
debug: CFLAGS += $(SANITIZE)
debug: exe

library: clean $(TARGET_LIB)
$(TARGET_LIB): CFLAGS += -pedantic -fvisibility=hidden -fPIC
$(TARGET_LIB): LDFLAGS += -Wl,--no-undefined -shared $(SANITIZE)
$(TARGET_LIB):  malloc.o $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $^

lib_debug: CFLAGS += -g
lib_debug: clean $(TARGET_LIB)

clean:
	$(RM) $(OBJS) $(EXE) $(TARGET_LIB) main.o

.PHONY: all $(TARGET_LIB) clean
