{
  // Fastfetch config — https://github.com/fastfetch-cli/fastfetch
  //
  // Logo: drop a PNG at ~/.config/fastfetch/logo.png
  // It will render inline in iTerm2 automatically.
  // For other terminals change "type" to: "sixel", "kitty", or "chafa"

  "logo": {
    "source": "~/.config/fastfetch/logo.png",
    "type": "kitty",
    "width": 24,
    "height": 12,
    "padding": {
      "top": 1,
      "right": 2
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "blue"
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    "separator",
    {
      "type": "os",
      "key": " OS",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "󰇄 Host",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "󰍛 GPU",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": " Memory",
      "keyColor": "blue"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "blue",
      "folders": "/"
    },
    "break",
    "colors"
  ]
}
