# -- Changing Window Focus --

# change window focus within space
cmd - h : yabai -m window --focus west
cmd - j : yabai -m window --focus south
cmd - k : yabai -m window --focus north
cmd - l : yabai -m window --focus east

cmd - h : yabai -m window --focus west || yabai -m display --focus west
cmd - l : yabai -m window --focus east || yabai -m display --focus east
cmd - j : yabai -m window --focus stack.next || yabai -m window --focus south
cmd - k : yabai -m window --focus stack.prev || yabai -m window --focus north


#change focus between external displays (up and down)
shift + alt - k: yabai -m display --focus north
shift + alt - j: yabai -m display --focus south

# -- Modifying the Layout --

# flip along y-axis
cmd + alt - y : yabai -m space --mirror y-axis

# flip along x-axis
cmd + alt - x : yabai -m space --mirror x-axis

# toggle window float
cmd + shift - space : yabai -m window --toggle float --grid 4:4:1:1:2:2


# -- Modifying Window Size --

# maximize a window
cmd + shift - f : yabai -m window --toggle zoom-fullscreen


# -- Moving Windows Around --

# move window to space #
cmd + alt - 1 : yabai -m window --space 1;
cmd + alt - 2 : yabai -m window --space 2;
cmd + alt - 3 : yabai -m window --space 3;
cmd + alt - 4 : yabai -m window --space 4;
cmd + alt - 5 : yabai -m window --space 5;
cmd + alt - 6 : yabai -m window --space 6;
cmd + alt - 7 : yabai -m window --space 7;

# -- Starting apps -- 

cmd - return : kitty --single-instance -d ~
cmd - b : open -na Firefox
cmd - e : open -na Finder
cmd - q : yabai -m window --close

